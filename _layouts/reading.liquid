---
layout: default
---
<link rel="stylesheet" href="{{ '/assets/css/reading.css' | relative_url }}">
<article class="reading-hub">
  <header class="reading-header">
    <p class="reading-eyebrow">{{ page.eyebrow | default: 'RESEARCH NOTES' }}</p>
    <h1>{{ page.heading | default: page.title }}</h1>
    {% if page.description %}<p class="reading-intro">{{ page.description }}</p>{% endif %}
  </header>
  {{ content }}
</article>
